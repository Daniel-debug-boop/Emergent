# Build output
dist/

# Native build output and pinned upstream source trees.
# third_party/ holds the upstream libraries the native engine builds against
# (Jolt, Recast/Detour, Volk, VMA, meshoptimizer, Flecs, miniaudio,
# ozz-animation, Zstandard, Tracy). They are pinned by revision, not vendored:
# the repository depends on them, and CI clones them explicitly. Committing
# them would add hundreds of megabytes of third-party code to the history.
third_party/
build/
build-native/

# Artefacts the native self-test writes into the working directory.
emergent_profile.json
emergent_content.ezpk
# Scratch file from the SPIR-V loader checks in the frame loop test. It is
# removed on the way out, but a failing run leaves it behind.
emergent_frame_loop_test.spv

# Compiled shaders. The GLSL in native/shaders is the source of truth; the
# .spv modules are build output and are regenerated by the CMake step whenever
# glslc or glslangValidator is available.
native/shaders/*.spv

# Dependencies
node_modules/

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/
