# Build output
dist/

# Native build output and pinned upstream source trees.
# third_party/ holds the upstream libraries the native engine builds against
# (Jolt, Recast/Detour, Volk, VMA, meshoptimizer, Flecs, miniaudio,
# ozz-animation, Zstandard, Tracy). They are pinned by revision, not vendored:
# the repository depends on them, and CI clones them explicitly. Committing
# them would add hundreds of megabytes of third-party code to the history.
third_party/
build/
build-native/

# Artefacts the native self-test writes into the working directory.
emergent_profile.json
emergent_content.ezpk
# Scratch file from the SPIR-V loader checks in the frame loop test. It is
# removed on the way out, but a failing run leaves it behind.
emergent_frame_loop_test.spv

# Compiled shaders. The GLSL in native/shaders is the source of truth; the
# .spv modules are build output and are regenerated by the CMake step whenever
# glslc or glslangValidator is available.
native/shaders/*.spv

# Dependencies
node_modules/

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/

# Downloaded source assets. Provenance is committed; the bytes are not.
# Recreate with `npm run assets:fetch`.
assets/source/
assets/.cache/

# The baked model set: 28 MB of base64 vertex data emitted by
# `npm run assets:models`. The curated list in assets/models.mjs and the
# importer that produces this are both committed; the payload is an artefact,
# like the texture tiles' source. Note this differs from assets/textures, which
# *is* committed because the game imports it directly. If the model set is ever
# loaded rather than imported, this line has to go.
assets/models.gen.mjs

# `npm run assets:textures`. The 26 baked CC0 materials as the native material
# table, and the three packed KTX2 maps under build/. The source PNGs in
# assets/textures are committed, exactly as for the models; this is the
# generated half. The CMake build regenerates it when node is available, and
# emergent_materials falls back to the untextured table when it is not.
assets/materials.gen.hpp
