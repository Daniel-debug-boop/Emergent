#version 450
// EMERGENT experimental GPU-driven visibility + LOD pass.
// The shader writes visibility flags and a compact LOD classification.
// Actual VkDrawIndexedIndirectCommand generation is enabled by the native Vulkan path
// only after buffers/pipeline barriers are available on the target device.
layout(local_size_x = 64) in;

struct Object {
    vec4 bounds;       // xyz=center, w=radius
    uint material;
    uint lod;
    float importance;
    float pad;
};

struct Result {
    uint visible;
    uint lod;
};

layout(std430, binding=0) readonly buffer Objects { Object objects[]; };
layout(std430, binding=1) writeonly buffer Results { Result results[]; };

layout(push_constant) uniform Params {
    vec4 cameraPos;
    float maxDistance;
    uint objectCount;
    float lodNear;
    float lodMid;
} params;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.objectCount) return;

    Object o = objects[i];
    float d = distance(o.bounds.xyz, params.cameraPos.xyz);
    bool visible = d - o.bounds.w <= params.maxDistance;

    uint lod = 3u;
    if (d <= params.lodNear) lod = 0u;
    else if (d <= params.lodMid) lod = 1u;
    else if (d <= params.maxDistance) lod = 2u;

    results[i].visible = visible ? 1u : 0u;
    results[i].lod = lod;
}
