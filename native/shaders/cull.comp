#version 450
layout(local_size_x = 64) in;
struct Object { vec4 bounds; uint material; uint lod; float importance; float pad; };
layout(std430,binding=0) readonly buffer Objects { Object objects[]; };
layout(std430,binding=1) buffer Visibility { uint visible[]; };
layout(push_constant) uniform Params { vec4 cameraPos; float maxDistance; uint objectCount; } params;
void main(){ uint i=gl_GlobalInvocationID.x; if(i>=params.objectCount)return; vec3 p=objects[i].bounds.xyz; float d=distance(p,params.cameraPos.xyz); visible[i]=(d<=params.maxDistance)?1u:0u; }
